# Documentation only: neither starter automatically loads this file.
STARTER_MODE=mock
FRAGMENT_BASE_URL=http://127.0.0.1:8081
STARTER_DB=orders-mock.sqlite
STARTER_SHOP_ID=demo
WORKER_CONCURRENCY=3
